"""v10.1 (H) — AI-Confirm Borderline.

Dipanggil HANYA untuk SATU kandidat borderline per loop (skor confluence mepet
di bawah threshold). Memakai endpoint OpenAI-compatible (mis. Bluesminds).

Aman by design: kalau AI error / timeout / ragu -> return False (TIDAK entry).
Tidak akan pernah memaksa entry kalau AI tidak yakin.
"""
from __future__ import annotations
import json, os
from pathlib import Path
from urllib.request import Request, urlopen


def _env(name: str, default: str = "") -> str:
    """Baca environment var, fallback ke file .env (root project)."""
    v = os.getenv(name)
    if v not in (None, ""):
        return v
    try:
        p = Path(".env")
        if p.exists():
            for line in p.read_text().splitlines():
                line = line.strip()
                if line.startswith("#") or "=" not in line:
                    continue
                k, val = line.split("=", 1)
                if k.strip() == name:
                    return val.strip().strip('"').strip("'")
    except Exception:
        pass
    return default


def _agent_cfg():
    """v14: AI Agent pakai KEY SENDIRI (AI_AGENT_API_KEY) yang diinput manual,
    DIPISAH dari key trading bot. Fallback ke OPENAI_* biar setup lama tetap jalan
    kalau AI_AGENT_* sengaja dikosongkan.
    Return (key, base_url, model).
    """
    key   = _env("AI_AGENT_API_KEY")  or _env("OPENAI_API_KEY")
    base  = (_env("AI_AGENT_BASE_URL") or _env("OPENAI_BASE_URL", "https://api.openai.com/v1")).rstrip("/")
    model = _env("AI_AGENT_MODEL")    or _env("OPENAI_MODEL", "gpt-4o-mini")
    return key, base, model


def confirm_entry(symbol, side, conf, conf_score, score_parts,
                  sentiment, news_bias, timeout: int = 25):
    key, base, model = _agent_cfg()
    if not key:
        return False, "no-key"

    prompt = (
        f"Trading entry confirmation.\n"
        f"Symbol: {symbol}\n"
        f"Side: {side}\n"
        f"ML confidence: {conf:.2f}\n"
        f"Confluence score: {conf_score:.2f}\n"
        f"Score parts: {score_parts}\n"
        f"Sentiment: {sentiment}\n"
        f"News bias: {news_bias}\n\n"
        "Answer with the FIRST word exactly YES or NO. "
        "Then give max 12 words reason. "
        "If unsure, answer NO."
    )

    try:
        import json
        from urllib.request import Request, urlopen

        req = Request(
            f"{base}/chat/completions",
            data=json.dumps({
                "model": model,
                "messages": [
                    {"role": "system", "content": "You are a strict trading risk gate. First word must be YES or NO."},
                    {"role": "user", "content": prompt},
                ],
                "temperature": 0.0,
                "max_tokens": 32,
            }).encode("utf-8"),
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {key}",
                "User-Agent": "pro-scalper-bot/1.0",
            },
        )

        with urlopen(req, timeout=timeout) as r:
            resp = json.loads(r.read().decode("utf-8", "ignore"))

        txt = resp["choices"][0]["message"]["content"].strip()
        up = txt.strip().upper()

        if not (up.startswith("YES") or up.startswith("NO")):
            return False, ("invalid-ai-response: " + txt[:70]).replace("\n", " ")

        ok = up.startswith("YES")
        return ok, txt[:90].replace("\n", " ")

    except Exception as e:
        return False, f"err:{e}"


def veto_entry(symbol, side, conf, conf_score, sentiment, news_bias,
               regime="unknown", strict: bool = False, timeout: int = 20):
    """
    AI hanya boleh PASS atau VETO.
    Safety update:
    - invalid response -> block, supaya jawaban random seperti Hello tidak jadi AI OK.
    - no-key/error tetap mengikuti strict lama.
    """
    key, base, model = _agent_cfg()
    if not key:
        return (not strict), "?", "no-key"

    prompt = (
        f"Trading veto check.\n"
        f"Symbol: {symbol}\n"
        f"Side: {side}\n"
        f"ML confidence: {conf:.2f}\n"
        f"Confluence score: {conf_score:.2f}\n"
        f"Sentiment: {sentiment}\n"
        f"News bias: {news_bias}\n"
        f"Regime: {regime}\n\n"
        "Decide if this trade should pass or be vetoed. "
        "Reply with the FIRST word exactly PASS or VETO, then grade A/B/C, then max 12 words reason. "
        "If your reply cannot start with PASS or VETO, the bot will block the trade."
    )

    try:
        import json, re
        from urllib.request import Request, urlopen

        req = Request(
            f"{base}/chat/completions",
            data=json.dumps({
                "model": model,
                "messages": [
                    {"role": "system", "content": "You are a strict trading risk gate. First word must be PASS or VETO."},
                    {"role": "user", "content": prompt},
                ],
                "temperature": 0.0,
                "max_tokens": 40,
            }).encode("utf-8"),
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {key}",
                "User-Agent": "pro-scalper-bot/1.0",
            },
        )

        with urlopen(req, timeout=timeout) as r:
            resp = json.loads(r.read().decode("utf-8", "ignore"))

        txt = resp["choices"][0]["message"]["content"].strip()
        up = txt.strip().upper()

        if not (up.startswith("PASS") or up.startswith("VETO")):
            return False, "?", ("invalid-ai-response: " + txt[:70]).replace("\n", " ")

        veto = up.startswith("VETO")
        gm = re.search(r"\b([ABC])\b", up)
        grade = gm.group(1) if gm else ("C" if veto else "B")

        return (not veto), grade, txt[:90].replace("\n", " ")

    except Exception as e:
        return (not strict), "?", f"err:{e}"

