def _profit_brain_load_memory():
    try:
        import json as _json, time as _time
        if not TRADE_MEMORY_FILE.exists(): return {}
        data=_json.loads(TRADE_MEMORY_FILE.read_text())
        now=_time.time(); changed=False
        for sym in list(data.keys()):
            sides=data.get(sym,{})
            if not isinstance(sides,dict):
                data.pop(sym,None); changed=True; continue
            for side in list(sides.keys()):
                item=sides.get(side,{})
                if not isinstance(item,dict) or float(item.get("expires_at",0) or 0)<now:
                    sides.pop(side,None); changed=True
            if not sides:
                data.pop(sym,None); changed=True
        if changed:
            TRADE_MEMORY_FILE.parent.mkdir(exist_ok=True)
            TRADE_MEMORY_FILE.write_text(_json.dumps(data))
        return data
    except Exception:
        return {}

def _profit_brain_save_memory(data):
    try:
        import json as _json
        TRADE_MEMORY_FILE.parent.mkdir(exist_ok=True)
        TRADE_MEMORY_FILE.write_text(_json.dumps(data))
    except Exception:
        pass

def _profit_brain_classify_loss(sym,side,pnl,roi):
    try: roi=float(roi or 0)
    except Exception: roi=0.0
    sym=str(sym).upper(); side=str(side).upper()
    if roi<=-7:
        return "long_failed_full_sl" if side=="LONG" else "short_failed_full_sl"
    if sym in {"LINKUSDT","SOLUSDT"}: return "choppy_pair_whipsaw"
    if sym in {"XAUUSDT","XAGUSDT"}: return "volatile_news_pair"
    return "recent_same_side_loss"

def _profit_brain_penalty_from_loss(pnl,roi):
    try: roi=float(roi or 0)
    except Exception: roi=0.0
    if roi<=-7: return 0.3,0.3,7200
    if roi<=-3: return 0.2,0.2,3600
    return 0.1,0.1,1800

def _profit_brain_update_from_log(lookback_lines=900):
    try:
        import re as _re, time as _time
        from pathlib import Path as _Path
        lf=_Path("logs/bot.log")
        if not lf.exists(): return
        lines=lf.read_text(errors="ignore").splitlines()[-int(lookback_lines):]
        mem=_profit_brain_load_memory(); now=_time.time()
        pat=_re.compile(r"Position\s+([A-Z0-9]+)\s+(LONG|SHORT)\s+closed.*realized\s+(-?[0-9.]+)\s+USDT\s+\((-?[0-9.]+)%",_re.I)
        changed=False
        for line in lines:
            m=pat.search(line)
            if not m: continue
            sym=m.group(1).upper(); side=m.group(2).upper(); pnl=float(m.group(3)); roi=float(m.group(4))
            if pnl>=0:
                if sym in mem and side in mem.get(sym,{}):
                    mem[sym].pop(side,None)
                    if not mem[sym]: mem.pop(sym,None)
                    changed=True
                continue
            pen,req,ttl=_profit_brain_penalty_from_loss(pnl,roi)
            reason=_profit_brain_classify_loss(sym,side,pnl,roi)
            old=(mem.get(sym,{}) or {}).get(side,{}) or {}
            repeat=int(old.get("repeat",0) or 0)+1
            if repeat>=2:
                pen=min(0.4,pen+0.1); req=min(0.4,req+0.1); ttl=max(ttl,10800)
            mem.setdefault(sym,{})[side]={"last_loss_ts":now,"symbol":sym,"side":side,"pnl":pnl,"roi":roi,"reason":reason,"penalty":round(pen,2),"extra_req":round(req,2),"repeat":repeat,"expires_at":now+ttl,"ttl_seconds":ttl,"mode":"soft_extra_confirm_not_hard_block"}
            changed=True
        if changed: _profit_brain_save_memory(mem)
    except Exception:
        pass

def _profit_brain_get_lesson(sym,side):
    try:
        import time as _time
        mem=_profit_brain_load_memory()
        item=((mem.get(str(sym).upper(),{}) or {}).get(str(side).upper(),{}) or {})
        if not item: return None
        if float(item.get("expires_at",0) or 0)<_time.time(): return None
        return item
    except Exception:
        return None


def _recent_loss_same_side(sym, side, lookback_lines=600, ttl_seconds=10800):
    """Learning memory ringan:
    Cek log terakhir apakah symbol+side baru loss.
    Kalau iya, next same-side signal diberi penalti sementara.
    """
    try:
        import re as _re, time as _time
        from pathlib import Path as _Path

        lf = _Path("logs/bot.log")
        if not lf.exists():
            return False, ""

        lines = lf.read_text(errors="ignore").splitlines()[-int(lookback_lines):]
        pat = _re.compile(
            r"Position\s+([A-Z0-9]+)\s+(LONG|SHORT)\s+closed.*realized\s+(-?[0-9.]+)",
            _re.I
        )

        for line in reversed(lines):
            m = pat.search(line)
            if not m:
                continue

            lsym = m.group(1).upper()
            lside = m.group(2).upper()
            pnl = float(m.group(3))

            if lsym == str(sym).upper() and lside == str(side).upper() and pnl < 0:
                return True, f"recent {lsym} {lside} loss {pnl}"
            if lsym == str(sym).upper() and pnl > 0:
                # Kalau pair yang sama sudah profit setelah loss, memory dianggap membaik.
                return False, ""

        return False, ""
    except Exception:
        return False, ""


def load_news_hunt(settings):
    try:
        import json as _json, time as _time
        if not NEWS_HUNT_FILE.exists():
            return {"mode":"normal","risk":"neutral","hot_pairs":[],"signals":[]}
        data=_json.loads(NEWS_HUNT_FILE.read_text())
        ttl=float(data.get("ttl",1800)); ts=float(data.get("ts",0))
        if ts and (_time.time()-ts>ttl):
            return {"mode":"normal","risk":"expired","hot_pairs":[],"signals":[]}
        data["hot_pairs"]=data.get("hot_pairs",[]) if isinstance(data.get("hot_pairs",[]),list) else []
        data["signals"]=data.get("signals",[]) if isinstance(data.get("signals",[]),list) else []
        return data
    except Exception:
        return {"mode":"normal","risk":"error","hot_pairs":[],"signals":[]}

def _news_hunt_for_symbol(news_hunt,sym):
    try:
        for x in (news_hunt or {}).get("hot_pairs",[]) or []:
            if str(x.get("symbol","")).upper().strip()==str(sym).upper().strip():
                return x
    except Exception:
        pass
    return None

def _news_hunt_signal_for_symbol(news_hunt,sym):
    try:
        best=None
        for x in (news_hunt or {}).get("signals",[]) or []:
            if str(x.get("symbol","")).upper().strip()!=str(sym).upper().strip():
                continue
            conf=float(x.get("confidence",0) or 0)
            if best is None or conf>float(best.get("confidence",0) or 0):
                best=x
        return best
    except Exception:
        return None


def load_regime(settings):
    """v10.1 (G): Baca regime pasar dari AI Agent (logs/regime.json).

    Return (regime_str, info_dict). info_dict bisa berisi override:
    confluence_min_score, cooldown_after_trade_seconds, cooldown_after_loss_seconds.
    """
    import json as _json, time as _time
    if not getattr(settings, "regime_enable", True):
        return "unknown", {}
    try:
        if not REGIME_FILE.exists():
            return "unknown", {}
        data = _json.loads(REGIME_FILE.read_text())
        ttl  = float(getattr(settings, "regime_ttl_seconds", 7200))
        ts   = float(data.get("ts", 0))
        if ttl > 0 and (_time.time() - ts) > ttl:
            return "unknown", {}  # kadaluarsa
        return str(data.get("regime", "unknown")), data
    except Exception:
        return "unknown", {}


