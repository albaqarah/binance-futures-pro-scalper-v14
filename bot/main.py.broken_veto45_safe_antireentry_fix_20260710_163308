            # -------- HARD 15m Direction Guard SAFE v2 --------
            # HARD15-SAFE-PRECISE-V2
            # Kompas 15m: jangan block kalau indikator fallback/default 50/50/0.
            # Tetap block kalau indikator valid dan 15m jelas melawan arah entry.
            try:
                import os as _h15_os
                import pandas as _pd
                from .features import create_scalping_features as _h15_feat
            
                _h15_on = str(_h15_os.getenv('HARD15_SAFE_ENABLE', 'true')).strip().lower() in ('1','true','yes','y','on')
                _h15_skip_default = str(_h15_os.getenv('HARD15_SKIP_DEFAULT_INDICATORS', 'true')).strip().lower() in ('1','true','yes','y','on')
                _h15_eps = float(_h15_os.getenv('HARD15_DEFAULT_EPS', '0.000001'))
            
                def _h15_df(_kl):
                    _cols12 = ['timestamp','open','high','low','close','volume','close_time','quote_vol','trades','taker_buy_base','taker_buy_quote','ignore']
                    if not _kl:
                        return None
                    if len(_kl[0]) >= 12:
                        _df = _pd.DataFrame(_kl, columns=_cols12)
                    else:
                        _df = _pd.DataFrame(_kl, columns=['timestamp','open','high','low','close','volume'])
                    _df = _df[['timestamp','open','high','low','close','volume']].copy()
                    for _c in ['open','high','low','close','volume']:
                        _df[_c] = _pd.to_numeric(_df[_c], errors='coerce')
                    return _df.dropna()
            
                def _h15_get(_row, _names, _default=50.0):
                    for _n in _names:
                        try:
                            if _n in _row:
                                return float(_row[_n])
                        except Exception:
                            pass
                    return float(_default)
            
                if _h15_on:
                    _kl15 = client.klines(sym, '15m', settings.klines_limit)
                    _df15 = _h15_df(_kl15)
                    if _df15 is not None and len(_df15) >= 30:
                        _feat15 = _h15_feat(_df15).dropna()
                        if len(_feat15) >= 4:
                            _a = _feat15.iloc[-1]
                            _b = _feat15.iloc[-2]
                            _c = _feat15.iloc[-3]
            
                            _close = float(_df15['close'].iloc[-1])
                            _close1 = float(_df15['close'].iloc[-2])
                            _open = float(_df15['open'].iloc[-1])
                            _ma7 = float(_df15['close'].rolling(7).mean().iloc[-1])
                            _ma25 = float(_df15['close'].rolling(25).mean().iloc[-1])
            
                            _rsi = _h15_get(_a, ['rsi','rsi_6','rsi6','RSI','RSI6'], 50.0)
                            _rsi1 = _h15_get(_b, ['rsi','rsi_6','rsi6','RSI','RSI6'], 50.0)
                            _st = _h15_get(_a, ['stochrsi','stoch_rsi','stochrsi_k','stoch_k','STOCHRSI'], 50.0)
                            _st1 = _h15_get(_b, ['stochrsi','stoch_rsi','stochrsi_k','stoch_k','STOCHRSI'], 50.0)
                            _st2 = _h15_get(_c, ['stochrsi','stoch_rsi','stochrsi_k','stoch_k','STOCHRSI'], 50.0)
                            _macd = _h15_get(_a, ['macd_hist','hist','macd','MACD'], 0.0)
                            _macd1 = _h15_get(_b, ['macd_hist','hist','macd','MACD'], 0.0)
                            _macd_delta = _macd - _macd1
            
                            _is_default = (
                                abs(_rsi - 50.0) <= _h15_eps
                                and abs(_st - 50.0) <= _h15_eps
                                and abs(_macd_delta - 0.0) <= _h15_eps
                            )
            
                            if _h15_skip_default and _is_default:
                                event(f'HARD-15M safe-skip {sym} {sig_side}: default indicators rsi={_rsi:.1f}, stoch={_st:.1f}, macdΔ={_macd_delta:.4f}')
                            else:
                                _rsi_up = _rsi > _rsi1
                                _rsi_dn = _rsi < _rsi1
                                _st_up = _st > _st1 and (_st1 <= _st2 or _st < 70)
                                _st_dn = _st < _st1 and (_st1 >= _st2 or _st > 30)
                                _macd_up = _macd > _macd1
                                _macd_dn = _macd < _macd1
                                _green = _close >= _open or _close > _close1
                                _red = _close <= _open or _close < _close1
            
                                _h15_bull = (
                                    (_rsi >= 55 and _rsi_up)
                                    or (_st <= 60 and _st_up and _macd_up)
                                    or (_close > _ma7 and _green and _rsi >= 50)
                                    or (_close > _ma25 and _rsi >= 55)
                                )
                                _h15_bear = (
                                    (_rsi <= 45 and _rsi_dn)
                                    or (_st >= 40 and _st_dn and _macd_dn)
                                    or (_close < _ma7 and _red and _rsi <= 50)
                                    or (_close < _ma25 and _rsi <= 45)
                                )
            
                                if sig_side == 'SHORT' and _h15_bull:
                                    event(f'{sym}: HARD-15M block SHORT (rsi={_rsi:.1f}, stoch={_st:.1f}, macdΔ={_macd_delta:.4f})')
                                    refresh_dashboard(free, daily, positions_view)
                                    time.sleep(1)
                                    continue
                                if sig_side == 'LONG' and _h15_bear:
                                    event(f'{sym}: HARD-15M block LONG (rsi={_rsi:.1f}, stoch={_st:.1f}, macdΔ={_macd_delta:.4f})')
                                    refresh_dashboard(free, daily, positions_view)
                                    time.sleep(1)
                                    continue
                                event(f'HARD-15M pass {sym} {sig_side} (rsi={_rsi:.1f}, stoch={_st:.1f}, macdΔ={_macd_delta:.4f})')
            except Exception as _h15e:
                event(f'HARD-15M safe guard error {sym}: {_h15e}', 'warning')

            # -------- MTF FAST-SCAN FINAL CONFIRM (1m/3m/5m/15m) --------
            # Final check sebelum entry:
            # - Block SHORT kalau 1m/3m/5m/15m mulai bounce naik.
            # - Block LONG kalau 1m/3m/5m/15m mulai reject turun.
            # Tujuan: jangan short bottom / long top, tapi tetap fast-rescan cari arah valid.
            try:
                import pandas as _pd
                from .features import create_scalping_features as _fs_feat

                def _fs_df(_kl):
                    _cols12 = [
                        "timestamp", "open", "high", "low", "close", "volume",
                        "close_time", "quote_vol", "trades", "taker_buy_base",
                        "taker_buy_quote", "ignore"
                    ]
                    if not _kl:
                        return None
                    if len(_kl[0]) >= 12:
                        _df = _pd.DataFrame(_kl, columns=_cols12)
                    else:
                        _df = _pd.DataFrame(_kl, columns=["timestamp", "open", "high", "low", "close", "volume"])
                    _df = _df[["timestamp", "open", "high", "low", "close", "volume"]].copy()
                    for _c in ["open", "high", "low", "close", "volume"]:
                        _df[_c] = _pd.to_numeric(_df[_c], errors="coerce")
                    return _df.dropna()

                def _fs_get(_row, _names, _default=0.0):
                    for _n in _names:
                        if _n in _row:
                            try:
                                return float(_row[_n])
                            except Exception:
                                pass
                    return _default

                def _fs_state(_tf, _kl_src=None):
                    try:
                        _klx = _kl_src if _kl_src is not None else client.klines(sym, _tf, settings.klines_limit)
                        _df = _fs_df(_klx)
                        if _df is None or len(_df) < 25:
                            return "neutral"

                        _feat = _fs_feat(_df).dropna()
                        if len(_feat) < 4:
                            return "neutral"

                        _a = _feat.iloc[-1]
                        _b = _feat.iloc[-2]
                        _c = _feat.iloc[-3]

                        _close = float(_df["close"].iloc[-1])
                        _close1 = float(_df["close"].iloc[-2])
                        _open = float(_df["open"].iloc[-1])
                        _low12 = float(_df["low"].tail(12).min())
                        _high12 = float(_df["high"].tail(12).max())

                        _ma7 = float(_df["close"].rolling(7).mean().iloc[-1])
                        _ma25 = float(_df["close"].rolling(25).mean().iloc[-1])

                        _rsi = _fs_get(_a, ["rsi", "rsi_6", "rsi6", "RSI", "RSI6"], 50.0)
                        _rsi1 = _fs_get(_b, ["rsi", "rsi_6", "rsi6", "RSI", "RSI6"], 50.0)

                        _st = _fs_get(_a, ["stochrsi", "stoch_rsi", "stochrsi_k", "stoch_k", "STOCHRSI"], 50.0)
                        _st1 = _fs_get(_b, ["stochrsi", "stoch_rsi", "stochrsi_k", "stoch_k", "STOCHRSI"], 50.0)
                        _st2 = _fs_get(_c, ["stochrsi", "stoch_rsi", "stochrsi_k", "stoch_k", "STOCHRSI"], 50.0)

                        _macd = _fs_get(_a, ["macd_hist", "hist", "macd", "MACD"], 0.0)
                        _macd1 = _fs_get(_b, ["macd_hist", "hist", "macd", "MACD"], 0.0)

                        _rsi_up = _rsi > _rsi1
                        _rsi_dn = _rsi < _rsi1
                        _st_up = (_st > _st1 and (_st1 <= _st2 or _st < 70))
                        _st_dn = (_st < _st1 and (_st1 >= _st2 or _st > 30))
                        _macd_up = _macd > _macd1
                        _macd_dn = _macd < _macd1

                        _green = _close > _open or _close > _close1
                        _red = _close < _open or _close < _close1

                        _near_low = (_close - _low12) / max(_low12, 1e-9) <= 0.008
                        _near_high = (_high12 - _close) / max(_high12, 1e-9) <= 0.008

                        # Bounce naik dari bawah / recovery.
                        _bounce_up = (
                            (_rsi <= 35 and _rsi_up and (_st_up or _macd_up))
                            or (_st <= 35 and _st_up and _macd_up)
                            or (_near_low and _green and _rsi_up)
                            or (_close > _ma7 and _rsi_up and _macd_up)
                        )

                        # Reject turun dari atas / fading.
                        _reject_down = (
                            (_rsi >= 65 and _rsi_dn and (_st_dn or _macd_dn))
                            or (_st >= 65 and _st_dn and _macd_dn)
                            or (_near_high and _red and _rsi_dn)
                            or (_close < _ma7 and _rsi_dn and _macd_dn)
                        )

                        if _bounce_up:
                            return "bounce_up"
                        if _reject_down:
                            return "reject_down"
                        return "neutral"
                    except Exception:
                        return "neutral"

                # Pakai kl aktif untuk tf0 kalau sesuai, sisanya fetch cepat.
                _fs_s1 = _fs_state("1m")
                _fs_s3 = _fs_state("3m")
                _fs_s5 = _fs_state(tf0, kl)
                _fs_s15 = _fs_state("15m")

                _bounce_votes = sum(1 for _x in [_fs_s1, _fs_s3, _fs_s5, _fs_s15] if _x == "bounce_up")
                _reject_votes = sum(1 for _x in [_fs_s1, _fs_s3, _fs_s5, _fs_s15] if _x == "reject_down")

                # Lebih ketat: kalau 5m/15m ikut bounce, SHORT harus diblok meski vote cuma 2.
                _major_bounce = (_fs_s5 == "bounce_up" or _fs_s15 == "bounce_up")
                _major_reject = (_fs_s5 == "reject_down" or _fs_s15 == "reject_down")

                if sig_side == "SHORT" and _bounce_votes >= 2 and _major_bounce:
                    event(
                        f"{sym}: FASTSCAN-MTF block SHORT "
                        f"(1m={_fs_s1}, 3m={_fs_s3}, 5m={_fs_s5}, 15m={_fs_s15})"
                    )
                    refresh_dashboard(free, daily, positions_view)
                    time.sleep(1)
                    continue

                if sig_side == "LONG" and _reject_votes >= 2 and _major_reject:
                    event(
                        f"{sym}: FASTSCAN-MTF block LONG "
                        f"(1m={_fs_s1}, 3m={_fs_s3}, 5m={_fs_s5}, 15m={_fs_s15})"
                    )
                    refresh_dashboard(free, daily, positions_view)
                    time.sleep(1)
                    continue

            except Exception as _fs_mtf_e:
                event(f"FASTSCAN-MTF guard error {sym}: {_fs_mtf_e}", "warning")

            # -------- Entry (hybrid: limit utk SOL/DOGE/XRP, market utk BNB) --------
            entry_fill = price
            if prof.order_type == "limit":
                bt = client.book_ticker(sym)
                limit_p = float(bt.get("bidPrice" if sig_side == "LONG" else "askPrice") or price)
                if settings.maker_first_enable:
                    _bid = float(bt.get("bidPrice") or limit_p)
                    _ask = float(bt.get("askPrice") or limit_p)
                    _tick = client.trade_rules(sym).get("tick_size", 0) or 0
                    limit_p = maker_price(sig_side, _bid, _ask, _tick, settings.maker_first_offset_ticks)
                try:
                    order = client.entry_limit_order(sym, sig_side, qty, limit_p)
                except Exception as e:
                    event(f"Limit entry {sym} failed: {e}", "warning")
                    time.sleep(settings.loop_seconds); continue
                oid = order.get("orderId")
                filled = False
                if settings.dry_run:
                    filled = True
                else:
                    waited = 0
                    while waited < settings.limit_fill_timeout_sec:
                        time.sleep(2); waited += 2
                        try:
                            st = client.order_status(sym, oid)
                            if str(st.get("status")) == "FILLED":
                                filled = True; break
                        except Exception:
                            continue
                    if not filled:
                        try: client.cancel_order(sym, oid)
                        except Exception: pass
                        event(f"Limit {sig_side} {sym} not filled in {settings.limit_fill_timeout_sec}s, cancelled")
                        refresh_dashboard(free, daily, positions_view); time.sleep(settings.loop_seconds); continue
                entry_fill = limit_p
                event(f"ENTRY LIMIT {sig_side} {sym} qty={qty} @ {client.round_price(sym, limit_p)} | ML conf={conf:.2f}")
            else:
                _ice = []
                if (settings.iceberg_enable
                        and qty * price >= (rules.get("min_notional", 5.0) or 5.0) * settings.iceberg_min_notional_mult):
                    _ice = split_iceberg(qty, settings.iceberg_chunks,
                                         rules.get("step_size", 0) or 0, rules.get("min_qty", 0) or 0)
                if len(_ice) > 1:
                    for _ci, _cq in enumerate(_ice):
                        client.entry_order(sym, sig_side, _cq)
                        if _ci < len(_ice) - 1:
                            time.sleep(0.5)
                    event(f"ENTRY MARKET iceberg x{len(_ice)} {sig_side} {sym} qty={qty} @~{price} | ML conf={conf:.2f}")
                else:
                    client.entry_order(sym, sig_side, qty)
                    event(f"ENTRY MARKET {sig_side} {sym} qty={qty} @~{price} | ML conf={conf:.2f}")

            # Ambil entry price aktual dari posisi (jika live)
            try:
                pos = next((q for q in client.open_positions() if q.get("symbol") == sym), None)
                if pos and float(pos.get("entryPrice") or 0) > 0:
                    entry_fill = float(pos["entryPrice"])
            except Exception:
                pass

            # -------- SL/TP per-pair (RR 1:2 + ATR utk SOL) --------
            try:
                kl2   = client.klines(sym, tf0, 80)
                highs_e = [float(k[2]) for k in kl2]
                lows_e  = [float(k[3]) for k in kl2]
                closes_e= [float(k[4]) for k in kl2]
                atr_e   = atr(highs_e, lows_e, closes_e, 14)
            except Exception:
                atr_e = 0.0

            sl, tp, sl_dist = plan_levels(sym, sig_side, entry_fill, atr_e, eff_min_tp, hc_meta.get("tp_mult", 0.0))
            if settings.dynamic_atr_tpsl_enable and atr_e > 0:
                _tb = dynamic_atr_tpsl(sig_side, entry_fill, atr_e,
                                       sl_mult=settings.atr_sl_mult, tp_mult=settings.atr_tp_mult,
                                       min_sl_pct=settings.atr_tpsl_min_sl_pct,
                                       max_sl_pct=settings.atr_tpsl_max_sl_pct)
                sl, tp, sl_dist = _tb.sl, _tb.tp, _tb.sl_dist
                event(f"Dynamic ATR TP/SL {sym}: SL={client.round_price(sym,sl)} TP={client.round_price(sym,tp)} (ATR={atr_e:.6f})")
            try:
                client.stop_loss_order(sym, sig_side, sl, qty)
                client.take_profit_order(sym, sig_side, tp, qty)
                sl_pct_r = sl_dist / entry_fill * 100 if entry_fill > 0 else 0
                event(f"SL={client.round_price(sym,sl)} TP={client.round_price(sym,tp)} (SL {sl_pct_r:.2f}% RR 1:{prof.rr:.0f})")
            except Exception as e:
                event(f"Placing SL/TP {sym} failed (code {_binance_code(e)}): {e}", "error")

            # Telegram: notif entry
            tg.entry(sym, sig_side, qty, entry_fill, sl, tp, conf,
                     fng=_sentiment.get("score", 50))

            state["last_trade_ts"] = time.time()
            state["daily_trades"]   = state.get("daily_trades", 0) + 1
            state.setdefault("last_trade_per_pair", {})[sym] = time.time()
            state.setdefault("entry_time", {})[sym] = time.time()
            save_state(state)
            refresh_dashboard(free, daily, positions_view)
            time.sleep(settings.loop_seconds)

        except KeyboardInterrupt:
            event("Dihentikan oleh user")
            break
        except Exception as e:
            event(f"Loop error: {e}", "error")
            time.sleep(10)


if __name__ == "__main__":
    main()
