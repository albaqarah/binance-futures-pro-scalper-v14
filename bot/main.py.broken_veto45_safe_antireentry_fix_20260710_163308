                    event(f"\u2705 AI OK {sig_side} {sym} [grade {_vgrade}]: {_vwhy}")

            # -------- Hitung qty (v10.1 E: Dynamic sizing by conviction) --------
            size_mult = 1.0
            if settings.dynamic_size_enable:
                size_mult = 1.0 + (conf_score - eff_conf_min) * settings.dynamic_size_per_point
                size_mult = max(settings.dynamic_size_min_mult,
