# v14: TradFi Perps (XAU/XAG) TIDAK 24/7. Buka ~ Minggu 22:00 UTC s/d Jumat 21:00 UTC,
# dengan jeda harian 21:00-22:00 UTC & Sabtu tutup penuh. Bot skip pair TradFi saat tutup
# biar gak entry pas gap/likuiditas kering.
def tradfi_market_open(now_utc=None) -> bool:
    from datetime import datetime as _dt, timezone as _tz
    now = now_utc or _dt.now(_tz.utc)
    wd, h = now.weekday(), now.hour        # Senin=0 .. Minggu=6
    if wd == 5:                             # Sabtu: tutup penuh
        return False
    if wd == 6 and h < 22:                  # Minggu sebelum 22:00 UTC
        return False
    if wd == 4 and h >= 21:                 # Jumat sesudah 21:00 UTC
        return False
    if h == 21:                             # jeda maintenance harian 21:00-22:00 UTC
        return False
    return True



