            # -------- Overextended Bounce/Rejection Guard --------
            # Blok LONG kalau harga sudah bounce jauh dari swing low + oscillator overbought.
            # Blok SHORT kalau harga sudah dump jauh dari swing high + oscillator oversold.
            try:
                import pandas as _pd
                from .features import create_scalping_features as _acf

                def _df_from_kl(_kl):
                    _cols12 = [
                        "timestamp", "open", "high", "low", "close", "volume",
                        "close_time", "quote_vol", "trades", "taker_buy_base",
                        "taker_buy_quote", "ignore"
                    ]
                    if len(_kl[0]) >= 12:
                        _df = _pd.DataFrame(_kl, columns=_cols12)
                    else:
                        _df = _pd.DataFrame(_kl, columns=["timestamp", "open", "high", "low", "close", "volume"])
                    _df = _df[["timestamp", "open", "high", "low", "close", "volume"]].copy()
                    for _col in ["open", "high", "low", "close", "volume"]:
                        _df[_col] = _pd.to_numeric(_df[_col], errors="coerce")
                    return _df.dropna()

                def _val(_row, _names, _default=50.0):
                    for _n in _names:
                        if _n in _row:
                            try:
                                return float(_row[_n])
                            except Exception:
                                pass
                    return _default

                def _over_state(_tf, _kl_src=None):
                    try:
                        _klx = _kl_src if _kl_src is not None else client.klines(sym, _tf, settings.klines_limit)
                        _df = _df_from_kl(_klx)
                        if len(_df) < 30:
                            return "neutral"

                        _feat = _acf(_df).dropna()
                        if len(_feat) < 5:
                            return "neutral"

                        _a = _feat.iloc[-1]
                        _b = _feat.iloc[-2]

                        _close = float(_df["close"].iloc[-1])
                        _close1 = float(_df["close"].iloc[-2])
                        _high = float(_df["high"].iloc[-1])
                        _low = float(_df["low"].iloc[-1])

                        _recent_low = float(_df["low"].tail(12).min())
                        _recent_high = float(_df["high"].tail(12).max())

                        _bounce_pct = (_close - _recent_low) / max(_recent_low, 1e-9)
                        _drop_pct = (_recent_high - _close) / max(_recent_high, 1e-9)

                        _rsi = _val(_a, ["rsi", "rsi_6", "rsi6", "RSI", "RSI6"], 50.0)
                        _rsi1 = _val(_b, ["rsi", "rsi_6", "rsi6", "RSI", "RSI6"], 50.0)

                        _st = _val(_a, ["stochrsi", "stoch_rsi", "stochrsi_k", "stoch_k", "STOCHRSI"], 50.0)
                        _st1 = _val(_b, ["stochrsi", "stoch_rsi", "stochrsi_k", "stoch_k", "STOCHRSI"], 50.0)

                        _macd = _val(_a, ["macd_hist", "hist", "macd", "MACD"], 0.0)
                        _macd1 = _val(_b, ["macd_hist", "hist", "macd", "MACD"], 0.0)

                        _stall_up = (_close <= _close1) or (_high <= float(_df["high"].iloc[-2]))
                        _stall_dn = (_close >= _close1) or (_low >= float(_df["low"].iloc[-2]))

                        # LINK contoh:
                        # 3m/5m RSI 80+, Stoch 95-100, bounce > ~0.8-1.2% dari low -> jangan LONG.
                        _long_overextended = (
                            (_bounce_pct >= 0.008 and _rsi >= 70 and _st >= 80)
                            or (_bounce_pct >= 0.006 and _rsi >= 75)
                            or (_rsi >= 80 and _st >= 90)
                        )

                        # Tambahan kalau mulai stall/reject di atas.
                        if _long_overextended and (_stall_up or _macd < _macd1 or _st <= _st1):
                            return "long_overextended"

                        # SHORT kebalikannya:
                        # sudah dump jauh dari recent high + oscillator oversold -> jangan SHORT.
                        _short_overextended = (
                            (_drop_pct >= 0.008 and _rsi <= 30 and _st <= 20)
                            or (_drop_pct >= 0.006 and _rsi <= 25)
                            or (_rsi <= 20 and _st <= 10)
                        )

                        if _short_overextended and (_stall_dn or _macd > _macd1 or _st >= _st1):
                            return "short_overextended"

                        return "neutral"
                    except Exception:
                        return "neutral"

                _o5 = _over_state(tf0, kl)
                _o3 = _over_state("3m")
                _o15 = _over_state("15m")

                _long_ext_votes = sum(1 for _x in [_o3, _o5, _o15] if _x == "long_overextended")
                _short_ext_votes = sum(1 for _x in [_o3, _o5, _o15] if _x == "short_overextended")

                if sig_side == "LONG" and _long_ext_votes >= 2:
                    event(
                        f"{sym}: OVEREXTENDED block LONG "
                        f"(3m={_o3}, 5m={_o5}, 15m={_o15})"
                    )
                    refresh_dashboard(free, daily, positions_view)
                    time.sleep(1)
                    continue

                if sig_side == "SHORT" and _short_ext_votes >= 2:
                    event(
                        f"{sym}: OVEREXTENDED block SHORT "
                        f"(3m={_o3}, 5m={_o5}, 15m={_o15})"
                    )
                    refresh_dashboard(free, daily, positions_view)
                    time.sleep(1)
                    continue

            except Exception as _oex:
                event(f"OVEREXTENDED guard error {sym}: {_oex}", "warning")


            # -------- MTF Anti-Chase Reversal Guard (3m/5m/15m) --------
            # Blok SHORT kalau multi-timeframe pendek sedang bounce naik dari bottom.
            # Blok LONG kalau multi-timeframe pendek sedang reject turun dari top.
            try:
                import pandas as _pd
                from .features import create_scalping_features as _acf

                def _mtf_kl_to_df(_kl):
                    _cols12 = [
                        "timestamp", "open", "high", "low", "close", "volume",
                        "close_time", "quote_vol", "trades", "taker_buy_base",
                        "taker_buy_quote", "ignore"
                    ]
                    if not _kl:
                        return None
                    if len(_kl[0]) >= 12:
                        _df = _pd.DataFrame(_kl, columns=_cols12)
                    else:
                        _df = _pd.DataFrame(_kl, columns=["timestamp", "open", "high", "low", "close", "volume"])
                    _df = _df[["timestamp", "open", "high", "low", "close", "volume"]].copy()
                    for _c in ["open", "high", "low", "close", "volume"]:
                        _df[_c] = _pd.to_numeric(_df[_c], errors="coerce")
                    return _df.dropna()

                def _mtf_get(_row, _names, _default=0.0):
                    for _n in _names:
                        if _n in _row:
                            try:
                                return float(_row[_n])
                            except Exception:
                                pass
                    return _default

                def _mtf_state(_tf, _kl_src=None):
                    # return: "bounce_up", "reject_down", atau "neutral"
                    try:
                        _klx = _kl_src if _kl_src is not None else client.klines(sym, _tf, settings.klines_limit)
                        _df = _mtf_kl_to_df(_klx)
                        if _df is None or len(_df) < 20:
                            return "neutral"

                        _feat = _acf(_df).dropna()
                        if len(_feat) < 4:
                            return "neutral"

                        _a = _feat.iloc[-1]
                        _b = _feat.iloc[-2]
                        _c = _feat.iloc[-3]

                        _rsi  = _mtf_get(_a, ["rsi", "rsi_6", "rsi6", "RSI", "RSI6"], 50.0)
                        _rsi1 = _mtf_get(_b, ["rsi", "rsi_6", "rsi6", "RSI", "RSI6"], 50.0)

                        _st   = _mtf_get(_a, ["stochrsi", "stoch_rsi", "stochrsi_k", "stoch_k", "STOCHRSI"], 50.0)
                        _st1  = _mtf_get(_b, ["stochrsi", "stoch_rsi", "stochrsi_k", "stoch_k", "STOCHRSI"], 50.0)
                        _st2  = _mtf_get(_c, ["stochrsi", "stoch_rsi", "stochrsi_k", "stoch_k", "STOCHRSI"], 50.0)

                        _macd  = _mtf_get(_a, ["macd_hist", "hist", "macd", "MACD"], 0.0)
                        _macd1 = _mtf_get(_b, ["macd_hist", "hist", "macd", "MACD"], 0.0)

                        _close  = float(_df["close"].iloc[-1])
                        _close1 = float(_df["close"].iloc[-2])
                        _low1   = float(_df["low"].iloc[-2])
                        _high1  = float(_df["high"].iloc[-2])

                        _rsi_up = _rsi > _rsi1
                        _rsi_dn = _rsi < _rsi1

                        _st_up = (_st > _st1 and (_st1 <= _st2 or _st < 55))
                        _st_dn = (_st < _st1 and (_st1 >= _st2 or _st > 45))

                        _macd_up = _macd > _macd1
                        _macd_dn = _macd < _macd1

                        _green = _close > _close1
                        _red   = _close < _close1

                        _bounce_from_low = _green and _close > _low1
                        _reject_from_high = _red and _close < _high1

                        _bounce_up = (
                            (_rsi <= 55 and _rsi_up and _st_up)
                            or (_st <= 45 and _st_up and _macd_up)
                            or (_rsi <= 50 and _macd_up and _bounce_from_low)
                        )

                        _reject_down = (
                            (_rsi >= 45 and _rsi_dn and _st_dn)
                            or (_st >= 55 and _st_dn and _macd_dn)
                            or (_rsi >= 50 and _macd_dn and _reject_from_high)
                        )

                        if _bounce_up:
                            return "bounce_up"
                        if _reject_down:
                            return "reject_down"
                        return "neutral"
                    except Exception:
                        return "neutral"

                _mtf_s5 = _mtf_state(tf0, kl)
                _mtf_s3 = _mtf_state("3m")
                _mtf_s15 = _mtf_state("15m")

                _bounce_votes = sum(1 for _x in [_mtf_s3, _mtf_s5, _mtf_s15] if _x == "bounce_up")
                _reject_votes = sum(1 for _x in [_mtf_s3, _mtf_s5, _mtf_s15] if _x == "reject_down")

                if sig_side == "SHORT" and _bounce_votes >= 2:
                    event(
                        f"{sym}: MTF-ANTI-CHASE block SHORT "
                        f"(3m={_mtf_s3}, 5m={_mtf_s5}, 15m={_mtf_s15})"
                    )
                    refresh_dashboard(free, daily, positions_view)
                    time.sleep(1)
                    continue

                if sig_side == "LONG" and _reject_votes >= 2:
                    event(
                        f"{sym}: MTF-ANTI-CHASE block LONG "
                        f"(3m={_mtf_s3}, 5m={_mtf_s5}, 15m={_mtf_s15})"
                    )
                    refresh_dashboard(free, daily, positions_view)
                    time.sleep(1)
