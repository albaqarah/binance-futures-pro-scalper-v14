                                    "realized": round(_real, 4), "roi_pct": round(_roi, 2),
                                    "duration_min": _dur,
                                    "result": "win" if _real >= 0 else "loss",
                                    "score": (_info.get("score", "") if isinstance(_info, dict) else ""),
                                    "regime": _regime, "news_bias": _news_bias,
                                    "reason": "SL/TP Binance",
                                })
                            except Exception as _je:
                                event(f"Journal failed: {_je}", "warning")
                    save_state(state)
            except Exception as e:
                event(f"Closed-position detection failed: {e}", "warning")

            # -------- kelola posisi terbuka (Force-TP / SL+ / penjaga) --------
            positions_view = []
            closed_any = False
            for p in open_pos:
                amt = float(p.get("positionAmt", 0) or 0)
                if amt == 0:
                    continue
                side  = "LONG" if amt > 0 else "SHORT"
                entry = float(p.get("entryPrice", 0) or 0)
                sym   = p.get("symbol", "?")
                mark  = client.mark_price(sym)
                up    = float(p.get("unRealizedProfit", 0) or 0)
                pp    = profit_pct(side, entry, mark)
                roi   = pp * settings.leverage
                be_done = bool(state.get("breakeven_done", {}).get(sym))

                closes_pos: list[float] = []
                atr_pos = 0.0
                try:
                    kl_pos  = client.klines(sym, tf0, 80)
                    highs_p = [float(k[2]) for k in kl_pos]
                    lows_p  = [float(k[3]) for k in kl_pos]
                    closes_pos = [float(k[4]) for k in kl_pos]
                    atr_pos = atr(highs_p, lows_p, closes_pos, 14)
                except Exception:
                    pass

                # --- TP Paksa StochRSI (hanya saat HIJAU & NET positif setelah fee) ---
                _fee_rt = _round_trip_fee_usdt(settings, entry, abs(amt))
                _min_net_usdt = (entry * abs(amt)) * settings.min_net_profit_pct if settings.fee_aware_tp else 0.0
                if settings.force_tp_enable and up > (_fee_rt + _min_net_usdt) and pp >= settings.force_tp_min_profit_pct and closes_pos:
                    try:
                        sk, _ = stoch_rsi(closes_pos)
                        hit = (
                            (side == "LONG"  and sk >= settings.force_tp_stoch_long)
                            or (side == "SHORT" and sk <= settings.force_tp_stoch_short)
                        )
                        if hit:
                            client.cancel_all_algo_orders(sym)
                            client.close_position_market(sym, side, abs(amt))
                            state["last_trade_ts"] = time.time()
                            state.setdefault("breakeven_done", {}).pop(sym, None)
                            state.setdefault("partial_done", {}).pop(sym, None)
                            # Hitung durasi SEBELUM pop entry_time (Fix Bug order)
                            _dur = int((time.time() - state.get("entry_time", {}).get(sym, time.time())) / 60)
                            state.setdefault("entry_time", {}).pop(sym, None)
                            state.setdefault("held_syms", {}).pop(sym, None)
                            _net = (up - _fee_rt) if settings.report_net_pnl else up
                            _margin = (entry * abs(amt) / max(1, settings.leverage)) if (entry and amt) else 0.0
                            _net_roi = (_net / _margin * 100.0) if _margin > 0 else roi * 100
                            if _net >= 0:
                                tg.close_win(sym, side, _net, _net_roi, _dur)
                            else:
                                tg.close_loss(sym, side, _net, _net_roi, _dur)
                                state["last_loss_ts"] = time.time()
                            save_state(state)
                            event(f"FORCE TP {side} {sym}: StochRSI %K={sk:.1f}, ROI {roi:+.2f}% locked")
                            closed_any = True
                            continue
                    except Exception as e:
                        event(f"Force-TP check {sym}: {e}", "warning")

                # --- penjaga SL/TP (pastikan proteksi aktif) ---
                try:
                    algo    = client.open_algo_orders(sym)
                    has_sl  = any("STOP" in str(o.get("type") or o.get("strategyType") or "").upper()
                                  and "TAKE_PROFIT" not in str(o.get("type") or "").upper() for o in algo)
                    has_tp  = any("TAKE_PROFIT" in str(o.get("type") or o.get("strategyType") or "").upper() for o in algo)
                    g_sl, g_tp, _ = plan_levels(sym, side, entry, atr_pos, eff_min_tp, _hc_for(state, sym).get("tp_mult", 0.0))

                    # -------- Early SL+ Profit Lock --------
                    # ROI +1.5% -> lock SL ke profit aman. Tidak close posisi, biarkan lanjut kalau trend kuat.
                    try:
                        _slp_trigger = _env_float_runtime("SLPLUS_TRIGGER_ROI", 1.5)
                        _slp_lock = _env_float_runtime("SLPLUS_LOCK_ROI", 0.6)

                        _entry_px = float(entry or 0)
                        _amt_abs = abs(float(amt or 0))
                        _mark_px = float(p.get("markPrice", 0) or p.get("entryPrice", 0) or 0)
                        if not _mark_px:
                            _mark_px = _entry_px

                        _roi_now = 0.0
                        try:
                            _margin_est = max(float(p.get("initialMargin", 0) or 0), float(p.get("positionInitialMargin", 0) or 0))
                            if _margin_est > 0:
                                _roi_now = (float(up or 0) / _margin_est) * 100.0
                            else:
                                _notional_est = max(_entry_px * _amt_abs, 1e-9)
                                _lev_est = float(getattr(settings, "leverage", 10) or 10)
                                _roi_now = (float(up or 0) / max(_notional_est / max(_lev_est, 1), 1e-9)) * 100.0
                        except Exception:
                            _roi_now = 0.0

                        _slp_key = f"{sym}:{side}:{round(_entry_px, 8)}:{round(abs(amt), 8)}:early_slplus"
                        _slp_done = bool(state.setdefault("early_slplus_done", {}).get(_slp_key))

                        if (not _slp_done) and _entry_px > 0 and _roi_now >= _slp_trigger:
                            rules = client.trade_rules(sym)
                            _tick = rules.get("tick_size", 0) or 0

                            # ROI futures dihitung terhadap margin.
                            # Lock ROI 0.6% di leverage 10x ~= price lock 0.06% dari entry.
                            _lev_est = float(getattr(settings, "leverage", 10) or 10)
                            _price_lock_pct = (_slp_lock / max(_lev_est, 1)) / 100.0

                            if side == "LONG":
                                _new_sl = _entry_px * (1.0 + _price_lock_pct)
                            else:
                                _new_sl = _entry_px * (1.0 - _price_lock_pct)

                            try:
                                _new_sl = round_step(_new_sl, _tick, rules.get("min_price", 0) or 0)
                            except Exception:
                                pass

                            try:
                                for _o in client.open_orders(sym):
                                    if "STOP" in str(_o.get("type","")).upper() and "TAKE" not in str(_o.get("type","")).upper():
                                        try:
                                            client.cancel_order(sym, _o.get("orderId"))
                                        except Exception:
                                            pass
                            except Exception:
                                pass

                            try:
                                client.stop_loss_order(
                                    sym,
                                    side,
                                    _new_sl,
                                    _amt_abs
                                )
                                state["early_slplus_done"][_slp_key] = True
                                state.setdefault("slplus_reentry", {})[sym] = {
                                    "side": side,
                                    "ts": time.time(),
                                    "reason": "early_slplus_lock",
                                    "reentry_enable": _env_bool_runtime("REENTRY_AFTER_SLPLUS_ENABLE", True),
                                    "cooldown": _env_int_runtime("REENTRY_COOLDOWN_SEC", 90)
                                }
                                save_state(state)
                                event(f"EARLY SL+ {sym}: ROI {_roi_now:+.2f}% -> lock {_slp_lock:.2f}% ROI @ {_new_sl}")
                            except Exception as _slpe:
                                event(f"EARLY SL+ failed {sym}: {_slpe}", "warning")

                    except Exception as _slp_outer:
                        event(f"EARLY SL+ guard error {sym}: {_slp_outer}", "warning")


                    if be_done:
                        g_sl = calc_breakeven_sl(side, entry, settings.breakeven_lock_roi / max(1, settings.leverage))
                    if not has_sl:
                        client.stop_loss_order(sym, side, g_sl, abs(amt))
                        event(f"Re-set SL {sym} @ {client.round_price(sym, g_sl)}")
                    if not has_tp:
                        client.take_profit_order(sym, side, g_tp, abs(amt))
                        event(f"Re-set TP {sym} @ {client.round_price(sym, g_tp)}")
                except Exception as e:
                    event(f"Re-setting SL/TP {sym} failed: {e}", "warning")

                # --- SL+ berbasis ROI ---
                if settings.breakeven_enable and not be_done and roi >= settings.breakeven_trigger_roi:
                    try:
                        cancelled = client.cancel_stop_loss_orders(sym)
                        lock_pct  = settings.breakeven_lock_roi / max(1, settings.leverage)
                        new_sl    = calc_breakeven_sl(side, entry, lock_pct)
                        client.stop_loss_order(sym, side, new_sl, abs(amt))
                        state.setdefault("breakeven_done", {})[sym] = True
                        save_state(state); be_done = True
                        event(f"SL+ {sym}: ROI {roi:+.2f}% -> lock +{settings.breakeven_lock_roi*100:.0f}% ROI (cancelled {cancelled} old SL)")
                        tg.breakeven(sym, roi * 100)
                    except Exception as e:
                        event(f"SL+ {sym} failed: {e}", "warning")

                # --- Trailing Stop Loss ---
                if (settings.trailing_sl_enable and be_done
                        and roi >= settings.trailing_sl_activate_roi):
                    try:
                        cb  = _hc_for(state, sym).get("trail") or settings.trailing_sl_callback_pct
                        if side == "LONG":
                            trail_sl = mark * (1 - cb)
                            # v15: pivot trailing (LONG)
                            _pv = pivot_trail_sl("LONG", highs_p, lows_p, atr_pos) if closes_pos else None
                            if _pv is not None and mark * 0.90 < _pv < mark:
                                trail_sl = _pv
                            # Geser SL ke atas jika lebih menguntungkan
                            cur_sl_orders = client.open_algo_orders(sym)
                            cur_sl_price  = 0.0
                            for o in cur_sl_orders:
                                if "STOP" in str(o.get("type","")).upper() and "TAKE" not in str(o.get("type","")).upper():
                                    cur_sl_price = float(o.get("stopPrice") or o.get("price") or 0)
                            if trail_sl > cur_sl_price and cur_sl_price > 0:
                                client.cancel_stop_loss_orders(sym)
                                client.stop_loss_order(sym, side, trail_sl, abs(amt))
                                event(f"Trailing SL {sym} ↑ {client.round_price(sym, trail_sl)} (ROI {roi:+.2f}%)")
                        elif side == "SHORT":
                            trail_sl = mark * (1 + cb)
                            # v15: pivot trailing (SHORT)
                            _pv = pivot_trail_sl("SHORT", highs_p, lows_p, atr_pos) if closes_pos else None
                            if _pv is not None and mark < _pv < mark * 1.10:
                                trail_sl = _pv
                            cur_sl_orders = client.open_algo_orders(sym)
                            cur_sl_price  = float('inf')
                            for o in cur_sl_orders:
                                if "STOP" in str(o.get("type","")).upper() and "TAKE" not in str(o.get("type","")).upper():
                                    cur_sl_price = float(o.get("stopPrice") or o.get("price") or float('inf'))
                            if trail_sl < cur_sl_price and cur_sl_price < float('inf'):
                                client.cancel_stop_loss_orders(sym)
                                client.stop_loss_order(sym, side, trail_sl, abs(amt))
                                event(f"Trailing SL {sym} \u2193 {client.round_price(sym, trail_sl)} (ROI {roi:+.2f}%)")
                    except Exception as e:
                        event(f"Trailing SL {sym} error: {e}", "warning")

                # --- Partial Close (cicil profit 50%) ---
                pc_done = bool(state.get("partial_done", {}).get(sym))
                _hc = _hc_for(state, sym)
                _pc_enable = bool(_hc.get("partial_enable", settings.partial_close_enable))
                _pc_ratio  = float(_hc.get("partial_ratio", settings.partial_close_ratio))
                if (_pc_enable and not pc_done
                        and roi >= settings.partial_close_roi and up > 0):
                    try:
                        close_qty = round(abs(amt) * _pc_ratio, 8)
                        if close_qty > 0:
                            client.close_position_market(sym, side, close_qty)
                            state.setdefault("partial_done", {})[sym] = True
                            save_state(state)
                            event(f"Partial Close {sym}: closed {_pc_ratio*100:.0f}% @ ROI {roi:+.2f}%")
                            tg.alert(f"\U0001f4b8 Partial Close {sym} {side} +{roi*100:.2f}% — {100-_pc_ratio*100:.0f}% left running")
                    except Exception as e:
                        event(f"Partial Close {sym} error: {e}", "warning")

                positions_view.append({"symbol": sym, "side": side, "qty": abs(amt),
                                        "entry": entry, "mark": mark, "upnl": up,
                                        "profit_pct": pp, "roi": roi, "breakeven_done": be_done})

            if closed_any:
                refresh_dashboard(free, daily, positions_view)
                time.sleep(settings.loop_seconds); continue

            # Snapshot posisi yang dipegang (utk deteksi penutupan di loop berikutnya)
            state["held_syms"] = {
                pv["symbol"]: {
                    "side": pv["side"],
                    "ts":   state.get("entry_time", {}).get(pv["symbol"], time.time()),
                    "margin": (pv["entry"] * pv["qty"] / max(1, settings.leverage))
                              if pv.get("entry") and pv.get("qty") else 0.0,
                }
                for pv in positions_view
            }

            held_symbols = {p.get("symbol") for p in open_pos}
            # Fix Bug3+4: Bersihkan semua state pair yang sudah tidak dipegang
            changed = False
            for _key in ("breakeven_done", "partial_done", "entry_time", "hc_meta"):
                _old = state.get(_key) or {}
                _new = {s: v for s, v in _old.items() if s in held_symbols}
                if _new != _old:
                    state[_key] = _new; changed = True
            if changed: save_state(state)

            if len(open_pos) >= settings.max_open_positions:
                refresh_dashboard(free, daily, positions_view)
                time.sleep(settings.loop_seconds); continue

            # Session Filter — hanya entry saat jam aktif
            _sess_ok, _sess_name = is_trading_session(settings.session_filter_enable)
            if not _sess_ok:
                screen_rows.clear()
                screen_rows.append({"symbol": "ALL", "long": "-", "short": "-",
                                    "side": "NONE", "status": f"\U0001f634 {_sess_name}"})
                refresh_dashboard(free, daily, positions_view)
                time.sleep(settings.loop_seconds); continue

            # Cooldown global & batas harian
            now = time.time()
            if GLOBAL_CD_ENABLE and now - state.get("last_trade_ts", 0) < eff_cd_trade:
                wait = int(eff_cd_trade - (now - state["last_trade_ts"]))
                event(f"Cooldown global {wait}s")
                refresh_dashboard(free, daily, positions_view)
                time.sleep(settings.loop_seconds); continue
            if GLOBAL_CD_ENABLE and now - state.get("last_loss_ts", 0) < eff_cd_loss:
                wait = int(eff_cd_loss - (now - state["last_loss_ts"]))
                event(f"Cooldown after-loss {wait}s")
                refresh_dashboard(free, daily, positions_view)
                time.sleep(settings.loop_seconds); continue
            if state.get("daily_trades", 0) >= settings.max_daily_trades:
                event("Daily trade limit reached")
                refresh_dashboard(free, daily, positions_view)
                time.sleep(settings.loop_seconds); continue

            # -------- Screening ML (ganti rule-based) --------
            screen_rows.clear()
            _tf15_cache: dict = {}
            best = None
            borderline = None  # v10.1 (H): kandidat near-miss utk AI-confirm
            _pair_cd = state.setdefault("last_trade_per_pair", {})
            for sym in settings.symbols:
                if sym in held_symbols:
                    screen_rows.append({"symbol": sym, "long": "-", "short": "-",
                                        "side": "NONE", "status": "position active"})
                    continue
                # Per-pair cooldown — cegah double entry pair yang sama
                # v15: per-symbol cooldown (loss lama, win sebentar)
                _ll = state.setdefault("last_loss_per_pair", {}).get(sym, 0)
                _lt = max(_pair_cd.get(sym, 0), state.setdefault("last_close_per_pair", {}).get(sym, 0))
                _cd_active = False
                _cd_wait = 0
                if PAIR_CD_ENABLE and now - _ll < PAIR_CD_LOSS:
                    _cd_active = True; _cd_wait = int(PAIR_CD_LOSS - (now - _ll))
                elif PAIR_CD_ENABLE and now - _lt < max(PAIR_CD_WIN, settings.min_reentry_seconds):
                    _cd_active = True; _cd_wait = int(max(PAIR_CD_WIN, settings.min_reentry_seconds) - (now - _lt))
                try:
                    kl  = client.klines(sym, tf0, settings.klines_limit)
                    # v14: TradFi guard — skip XAU/XAG kalau pasar emas/perak lagi tutup (weekend/jeda).
                    if (settings.tradfi_guard_enable and is_tradfi_symbol(sym, settings)
                            and not tradfi_market_open()):
                        continue
                    # Refresh sentiment tiap jam
                    if time.time() - _sent_ts > 3600:
                        _sentiment = get_fear_greed()
                        _sent_ts   = time.time()
                        log.info(log_sentiment(_sentiment))

                    # Hybrid: ML dulu, rule-based fallback kalau HOLD/model belum ada
                    if ml_ready:
                        signal, conf = ml_engine.predict_signal(kl, sym, pair_label=sym)
                        if signal == "HOLD":
                            rb_sig, rb_conf = rule_signal(kl, sym)
                            if rb_sig != "HOLD":
                                signal, conf = rb_sig, rb_conf * 0.9
                    else:
                        signal, conf = rule_signal(kl, sym)

                    # ── v10.1 (B): Fast-Scan Breakout — tangkap momentum yg kelewat ──
                    bo_dir, bo_str = ("HOLD", 0.0)
                    if settings.fast_scan_enable:
                        bo_dir, bo_str = breakout_signal(kl, settings.breakout_lookback,
                                                         settings.breakout_vol_mult)
                        if signal == "HOLD" and bo_dir != "HOLD":
                            signal = bo_dir
                            conf   = max(conf, settings.breakout_conf)

                    # ── v10: CONFLUENCE SCORING (Opsi A) ──
                    # Tiap filter memberi poin (+/-), bukan veto mati.
                    # Entry kalau total skor >= settings.confluence_min_score.
                    # v15: Mode Selector AND-gate
                    if signal != "HOLD":
                        _tradfi_scout = False
                        _m_ok, _m_res = gate_ok(signal, kl)
                        if not _m_ok:
                            # RODI-V2.3B-MODE-SOFT-OVERRIDE
                            # Soft override mode gate for BOT KERJA RODI.
                            # Normal mode gate remains active unless extra scan candidate is strong enough.
                            try:
                                import os as _rodi_os_mode
                                _rodi_mode_on = str(_rodi_os_mode.getenv('EXTRA_SCAN_ALL_PAIRS', 'false')).strip().lower() in ('1', 'true', 'yes', 'y', 'on')
                                _rodi_mode_min = float(_rodi_os_mode.getenv('EXTRA_SCAN_MIN_SOFT_CONF', '0.44'))
                                _rodi_mode_override = (
                                    _rodi_mode_on
                                    and signal != 'HOLD'
                                    and float(conf) >= _rodi_mode_min
                                    and str(getattr(_m_res, 'mode', '')).upper() in ('TREND', 'NO_TRADE', 'SIDEWAYS')
                                )
                            except Exception:
                                _rodi_mode_override = False
                            if _rodi_mode_override:
                                event(f"RODI-MODE override {sym} {signal} mode {getattr(_m_res, 'mode', '?')} conf={float(conf):.2f}")
                            else:
                                event(f"{sym}: mode {_m_res.mode} tolak {signal}")
                                continue
                    conf_score = 0.0
                    sc_parts = []
                    _hunt_extra_min = 0.0
                    _smart_extra_min = 0.0
                    _nh = locals().get("_news_hunt", {"mode":"normal","risk":"neutral","hot_pairs":[],"signals":[]})
                    if signal != "HOLD":
                        base = round((conf - 0.5) * 10.0, 1)   # ML: 0.50->0, 0.70->+2, 0.85->+3.5
                        conf_score += base
                        sc_parts.append(f"ML{base:+.1f}")
                        
                        # TRADFI-SCOUT: XAU/XAG diberi kesempatan saat mode selector terlalu kaku.
                        # Tetap bukan auto-entry: AI/FASTSCAN/HARD-15M/guard lain masih wajib lolos.
                        if locals().get("_tradfi_scout", False):
                            _ts_bonus = _tradfi_scout_env_float("TRADFI_SCOUT_SCORE_BONUS", 0.4)
                            _ts_req = _tradfi_scout_env_float("TRADFI_SCOUT_REQ_EXTRA", 0.1)
                            conf_score += _ts_bonus
                            _hunt_extra_min = locals().get("_hunt_extra_min", 0.0) + _ts_req
                            sc_parts.append(f"TRADFISCOUT+{_ts_bonus:.1f}")
                            sc_parts.append(f"TRADFIreq+{_ts_req:.1f}")
                        # HIGH-CONF FAST LANE:
                        # Conf tinggi jangan diperlakukan sama seperti threshold minimal.
                        try:
                            if float(conf) >= 0.75:
                                conf_score += 0.8
                                sc_parts.append("HIGHCONF+0.8")
                            elif float(conf) >= 0.65:
                                conf_score += 0.4
                                sc_parts.append("STRONGCONF+0.4")
                        except Exception:
                            pass


                        # PROFIT BRAIN v2 structured memory
                        try:
                            _lesson=_profit_brain_get_lesson(sym,signal)
                            if _lesson:
                                _pb_pen=float(_lesson.get("penalty",0) or 0)
                                _pb_req=float(_lesson.get("extra_req",0) or 0)
                                _pb_reason=str(_lesson.get("reason","loss_memory"))[:32]
                                if _pb_pen:
                                    conf_score-=_pb_pen
                                    sc_parts.append(f"PB-{_pb_pen:.1f}")
                                if _pb_req:
                                    _smart_extra_min+=_pb_req
                                    sc_parts.append(f"PBreq+{_pb_req:.1f}")
                                sc_parts.append(f"PB:{_pb_reason}")
                        except Exception:
                            pass

                        # LEARNING MEMORY:
                        # Kalau pair+side baru loss, jangan ulang pola sama tanpa extra kualitas.
                        try:
                            _loss_mem, _loss_why = _recent_loss_same_side(sym, signal)
                            if _loss_mem:
                                conf_score -= 0.3
                                _smart_extra_min += 0.2
                                sc_parts.append("LEARN-0.3")
                                sc_parts.append("LEARNreq+0.2")
                        except Exception:
                            pass


                        # Breakout bonus (B) — sinyal searah breakout momentum
                        if settings.fast_scan_enable and bo_dir == signal and bo_dir != "HOLD":
                            conf_score += settings.w_breakout
                            sc_parts.append(f"BO{settings.w_breakout:+.1f}")

                        # Sentiment (Fear & Greed)
                        sf = _sentiment.get("signal_filter", "ok")
                        if (sf == "skip_long" and signal == "LONG") or (sf == "skip_short" and signal == "SHORT"):
                            conf_score += settings.w_sentiment_against
                            sc_parts.append(f"Sent{settings.w_sentiment_against:+.1f}")

                        # News-bias legacy, default OFF kalau NEWS_BIAS_ENABLE=false
                        if _news_bias in ("long", "short"):
                            if _news_bias == signal.lower():
                                conf_score += settings.w_news_align
                                sc_parts.append(f"News{settings.w_news_align:+.1f}")
                            else:
                                conf_score += settings.w_news_against
                                sc_parts.append(f"News{settings.w_news_against:+.1f}")

                        # NEWS-HUNT: radar peluang, bukan bias global
                        try:
                            _hot = _news_hunt_for_symbol(_nh, sym)
                            _scout = _news_hunt_signal_for_symbol(_nh, sym)
                            if _hot:
                                _risk = str(_hot.get("risk", _nh.get("risk","neutral"))).lower()
                                if _risk == "high":
                                    _hunt_extra_min += 0.2
                                    sc_parts.append("HUNTreq+0.2")
                                elif _risk == "medium":
                                    _hunt_extra_min += 0.1
                                    sc_parts.append("HUNTreq+0.1")
                                else:
                                    sc_parts.append("HUNT")
                            if _scout:
                                _sside = str(_scout.get("side","")).upper().strip()
                                _sconf = float(_scout.get("confidence",0) or 0)
                                if _sside == signal:
                                    _bonus = 0.8 if _sconf >= 0.70 else 0.5
                                    conf_score += _bonus
                                    sc_parts.append(f"Scout{_bonus:+.1f}")
                                elif _sside in ("LONG","SHORT"):
                                    _pen = -0.8 if _sconf >= 0.70 else -0.5
                                    conf_score += _pen
                                    sc_parts.append(f"Scout{_pen:+.1f}")
                        except Exception:
                            pass

                        # MTF (trend timeframe lebih besar)
                        if settings.mtf_enable:
                            htf_trend = get_htf_trend(client, sym, tf0)
                            if mtf_confirms(htf_trend, signal):
                                conf_score += settings.w_mtf_align
                                sc_parts.append(f"MTF{settings.w_mtf_align:+.1f}")
                            else:
                                conf_score += settings.w_mtf_against
                                sc_parts.append(f"MTF{settings.w_mtf_against:+.1f}")

                        # v12 (5): Screening 15m (konfirmasi tren TF lebih tinggi) + cache utk High-Conviction
                        if settings.screen_15m_enable:
                            try:
                                kl15 = client.klines(sym, settings.screen_15m_tf, settings.klines_limit)
                                if ml_ready:
                                    s15, c15 = ml_engine.predict_signal(kl15, sym, pair_label=sym)
                                    if s15 == "HOLD":
                                        s15, c15 = rule_signal(kl15, sym)
                                else:
                                    s15, c15 = rule_signal(kl15, sym)
                                _tf15_cache[sym] = (s15, c15)
                                if s15 != "HOLD":
                                    if s15 == signal:
                                        conf_score += settings.w_screen_15m_align
                                        sc_parts.append(f"15m{settings.w_screen_15m_align:+.1f}")
                                    else:
                                        conf_score += settings.w_screen_15m_against
                                        sc_parts.append(f"15m{settings.w_screen_15m_against:+.1f}")
                            except Exception:
                                pass

                        # Order Book (tekanan beli/jual)
                        if settings.orderbook_filter_enable:
                            ob = get_imbalance(sym)
                            if orderbook_confirms(ob, signal):
                                conf_score += settings.w_ob_align
                                sc_parts.append(f"OB{settings.w_ob_align:+.1f}")
                            else:
                                conf_score += settings.w_ob_against
                                sc_parts.append(f"OB{settings.w_ob_against:+.1f}")

                        # v11 (1): Order-Flow Anomaly (cumulative delta + imbalance + spoof)
                        if settings.orderflow_enable:
                            of = analyze_orderflow(client, sym, kl, settings.of_lookback, settings.of_wall_ratio)
                            if of["bias"] != "NEUTRAL":
                                if of["bias"] == signal:
                                    conf_score += settings.w_orderflow_align
                                    sc_parts.append(f"OF{settings.w_orderflow_align:+.1f}")
                                else:
                                    conf_score += settings.w_orderflow_against
                                    sc_parts.append(f"OF{settings.w_orderflow_against:+.1f}")
                            if of["spoof"]:
                                conf_score += settings.of_spoof_penalty
                                sc_parts.append(f"SPOOF{settings.of_spoof_penalty:+.1f}")
                                event(f"⚠️ {of['warning']}", "warning")

                        # v11 (3): Squeeze / Volatility predictor -> dukung breakout
                        if settings.squeeze_enable:
                            sq = squeeze_signal(client, sym, kl,
                                                settings.squeeze_funding_extreme,
                                                settings.squeeze_oi_rise_pct)
                            if sq["squeeze"] and sq["direction"] == signal:
                                conf_score += settings.w_squeeze_align
                                sc_parts.append(f"SQZ{settings.w_squeeze_align:+.1f}")
                                event(f"🌪️ {sq['note']}")

                        # v11 (2): Positioning bias (Binance GRATIS: retail vs top-trader L/S)
                        if settings.positioning_enable:
                            ps = positioning_signal(client, sym, settings.ls_crowd_extreme)
                            if ps["bias"] in ("LONG", "SHORT"):
                                if ps["bias"] == signal:
                                    conf_score += settings.w_positioning_align
                                    sc_parts.append(f"POS{settings.w_positioning_align:+.1f}")
                                    if ps["note"]:
                                        event(f"📡 {ps['note']}")
                                else:
                                    conf_score += settings.w_positioning_against
                                    sc_parts.append(f"POS{settings.w_positioning_against:+.1f}")
                    conf_score = round(conf_score, 1)
                    # RODI-V2-SAFE-RANK-HOOK
                    try:
                        import os as _rodi_os
                        if str(_rodi_os.getenv("EXTRA_SCAN_ALL_PAIRS", "false")).strip().lower() in ("1", "true", "yes", "y", "on"):
                            _rodi_sig = str(signal).upper()
                            if _rodi_sig in ("LONG", "SHORT"):
                                _rodi_bonus = float(_rodi_os.getenv("EXTRA_SCAN_SCORE_BONUS", "0.20"))
                                _rodi_req = float(_rodi_os.getenv("EXTRA_SCAN_REQ_EXTRA", "0.05"))
                                conf_score = round(float(conf_score) + _rodi_bonus, 1)
                                _hunt_extra_min = locals().get("_hunt_extra_min", 0.0) + _rodi_req
                                try:
                                    sc_parts.append(f"RODI+{_rodi_bonus:.2f}")
                                    sc_parts.append(f"RODIreq+{_rodi_req:.2f}")
                                except Exception:
                                    pass
                                try:
                                    event(f"EXTRA-SCAN candidate {sym} {signal} conf={float(conf):.2f} score={float(conf_score):+.1f}")
                                except Exception:
                                    pass
                    except Exception as _rodi_e:
                        try:
                            event(f"EXTRA-SCAN hook err {sym}: {_rodi_e}", "warning")
                        except Exception:
                            pass
                except Exception as e:
                    screen_rows.append({"symbol": sym, "long": "-", "short": "-",
                                        "side": "NONE", "status": f"err: {e}"})
                    event(f"ML screen {sym} error: {e}", "warning")
                    continue

                prob_str = f"{conf*100:.0f}%"
                sc_str   = " ".join(sc_parts) if sc_parts else "-"
                # RODI-V2.2C-PROMOTE-PASSED
                try:
                    import os as _rodi_os2
                    _rodi_promote = (
                        str(_rodi_os2.getenv("EXTRA_SCAN_ALL_PAIRS", "false")).strip().lower() in ("1", "true", "yes", "y", "on")
                        and signal != "HOLD"
                        and float(conf) >= float(_rodi_os2.getenv("EXTRA_SCAN_MIN_SOFT_CONF", "0.44"))
                        and float(conf_score) >= float(locals().get("_eff_conf_min", eff_conf_min))
                    )
                except Exception:
                    _rodi_promote = False
                passed = (
                    signal != "HOLD"
                    and (
                        float(conf) >= float(settings.ml_proba_threshold)
                        or _rodi_promote
                    )
                    and conf_score >= locals().get("_eff_conf_min", eff_conf_min)
                )
                if signal == "HOLD":
                    status = f"HOLD ({prob_str})"
                elif passed:
                    status = f"{signal} {prob_str} | skor {conf_score:+.1f} ✓ [{sc_str}]"
                else:
                    status = f"HOLD | skor {conf_score:+.1f} < {eff_conf_min:+.1f} [{sc_str}]"
                screen_rows.append({"symbol": sym, "long": prob_str if signal == "LONG" else "-",
                                    "short": prob_str if signal == "SHORT" else "-",
                                    "side": signal if passed else "NONE",
                                    "status": status, "score": conf_score})
                # Pilih kandidat terbaik berdasarkan SKOR confluence tertinggi
                if passed and (best is None or conf_score > best[3]):
                    best = (sym, signal, conf, conf_score)
                # v10.1 (H): simpan near-miss (lolos ML, skor mepet di bawah threshold)
                elif (signal != "HOLD" and conf >= settings.ml_proba_threshold
                      and conf_score < locals().get("_eff_conf_min", eff_conf_min)
                      and conf_score >= locals().get("_eff_conf_min", eff_conf_min) - settings.borderline_margin):
                    if borderline is None or conf_score > borderline[3]:
                        borderline = (sym, signal, conf, conf_score, list(sc_parts))
                refresh_dashboard(free, daily, positions_view)

            # v10.1 (H): tak ada yg lolos tapi ada near-miss -> minta AI confirm SEKALI
            if best is None and borderline is not None and settings.ai_confirm_enable:
                _bs, _bsig, _bconf, _bscore, _bparts = borderline
                try:
                    from .ai_confirm import confirm_entry
                    _ok, _why = confirm_entry(_bs, _bsig, _bconf, _bscore, _bparts,
                                              _sentiment, _news_bias)
                    if _ok:
                        best = (_bs, _bsig, _bconf, _bscore)
                        event(f"AI-CONFIRM ✓ {_bsig} {_bs} score {_bscore:+.1f} (near-miss rescued): {_why}")
                    else:
                        event(f"AI-CONFIRM ✗ {_bsig} {_bs} score {_bscore:+.1f}: {_why}")
                except Exception as e:
                    event(f"AI-confirm error: {e}", "warning")

            if best is None:
                event("No ML signal passed the threshold")
                refresh_dashboard(free, daily, positions_view)
                time.sleep(settings.loop_seconds); continue

            sym, sig_side, conf, conf_score = best

            # v12 (7): High-Conviction Mode — sinyal buagus -> perpanjang TP & aktifkan partial.
            hc_meta = {}
            if settings.high_conviction_enable:
                s15, c15 = _tf15_cache.get(sym, ("HOLD", 0.0))
                if s15 == sig_side and c15 >= settings.hc_conf1:
                    hc_meta = {"tier": 1, "tp_mult": settings.hc_tp_mult1,
                               "trail": settings.hc_trail1,
                               "partial_ratio": settings.hc_partial1, "partial_enable": True}
                    event(f"\U0001f525 HIGH-CONVICTION T1 {sig_side} {sym}: 15m conf {c15*100:.0f}% -> TP x{settings.hc_tp_mult1}, partial {settings.hc_partial1*100:.0f}%")
                elif conf >= settings.hc_conf2:
                    hc_meta = {"tier": 2, "tp_mult": settings.hc_tp_mult2,
                               "trail": settings.hc_trail2,
                               "partial_ratio": settings.hc_partial2, "partial_enable": True}
                    event(f"\U0001f525 HIGH-CONVICTION T2 {sig_side} {sym}: 5m conf {conf*100:.0f}% -> TP x{settings.hc_tp_mult2}, partial {settings.hc_partial2*100:.0f}%")
            if hc_meta:
                state.setdefault("hc_meta", {})[sym] = hc_meta
                save_state(state)

            # -------- Gerbang pra-entry --------
            # 1. Jam: hindari 5 menit pertama candle 1H
            if datetime.now(timezone.utc).minute < settings.avoid_first_minutes_of_hour:
                event(f"Skip {sym}: first {settings.avoid_first_minutes_of_hour} minutes of the 1H candle")
                refresh_dashboard(free, daily, positions_view); time.sleep(settings.loop_seconds); continue

            # 2. Funding rate
            try:
                fr = client.funding_rate(sym)
                if abs(fr) > settings.funding_rate_max:
                    event(f"Skip {sym}: funding {fr*100:.3f}% > batas")
                    refresh_dashboard(free, daily, positions_view); time.sleep(settings.loop_seconds); continue
            except Exception:
                pass

            # 3. Spread
            prof = profile_for(sym)
            if settings.spread_filter_enable:
                try:
                    sp = client.spread_pct(sym)
                    if sp > prof.max_spread_pct:
                        event(f"Skip {sym}: spread {sp*100:.3f}% > {prof.max_spread_pct*100:.2f}%")
                        refresh_dashboard(free, daily, positions_view); time.sleep(settings.loop_seconds); continue
                except Exception:
                    pass

            # AI-DIRECTION-GATE-V1
            # Guard arah TF 1m/3m/5m/15m sebelum AI veto/order.
            # Cegah LONG saat mayoritas TF jelas SHORT, dan cegah SHORT saat mayoritas TF jelas LONG.
            try:
                import os as _ai_dg_os
                _dg_on = str(_ai_dg_os.getenv('AI_DIRECTION_GATE_ENABLE', 'true')).strip().lower() in ('1','true','yes','y','on')
                _dg_strict = str(_ai_dg_os.getenv('AI_DIRECTION_GATE_STRICT', 'true')).strip().lower() in ('1','true','yes','y','on')
                _dg_tfs = [x.strip() for x in _ai_dg_os.getenv('AI_DIRECTION_GATE_TFS', '1m,3m,5m,15m').split(',') if x.strip()]
                _dg_min_agree = int(float(_ai_dg_os.getenv('AI_DIRECTION_GATE_MIN_AGREE', '3')))
                _dg_min_move = float(_ai_dg_os.getenv('AI_DIRECTION_GATE_MIN_MOVE', '0.00025'))
                if _dg_on and sig_side in ('LONG', 'SHORT'):
                    _dg_votes = []
                    for _tf in _dg_tfs:
                        try:
                            _kl_dg = client.klines(sym, _tf, min(settings.klines_limit, 80))
                            if not _kl_dg or len(_kl_dg) < 20:
                                continue
                            _c0 = float(_kl_dg[-1][4])
                            _c3 = float(_kl_dg[-4][4])
                            _c8 = float(_kl_dg[-9][4])
                            _move3 = (_c0 - _c3) / max(_c3, 1e-12)
                            _move8 = (_c0 - _c8) / max(_c8, 1e-12)
                            _bias = 'FLAT'
                            if _move3 > _dg_min_move and _move8 > 0:
                                _bias = 'LONG'
                            elif _move3 < -_dg_min_move and _move8 < 0:
                                _bias = 'SHORT'
                            _dg_votes.append((_tf, _bias, _move3, _move8))
                        except Exception:
                            continue
                    _long_n = sum(1 for _,b,_,_ in _dg_votes if b == 'LONG')
                    _short_n = sum(1 for _,b,_,_ in _dg_votes if b == 'SHORT')
                    _opp = 'SHORT' if sig_side == 'LONG' else 'LONG'
                    _opp_n = _short_n if sig_side == 'LONG' else _long_n
                    if _dg_strict and _opp_n >= _dg_min_agree:
                        event(f"AI-DIR-GATE block {sig_side} {sym}: tf_bias={_opp} agree={_opp_n}/{len(_dg_votes)} votes={[(a,b) for a,b,_,_ in _dg_votes]}")
                        refresh_dashboard(free, daily, positions_view); time.sleep(settings.loop_seconds); continue
                    elif _dg_votes:
                        event(f"AI-DIR-GATE pass {sig_side} {sym}: long={_long_n} short={_short_n} votes={[(a,b) for a,b,_,_ in _dg_votes]}")
            except Exception as _dg_e:
                event(f"AI-DIR-GATE err {sym}: {_dg_e}", 'warning')

            # v14: AI VETO GATE — konfirmasi akhir kandidat TERBAIK sebelum entry.
            # ML = generator sinyal; AI = overseer yang HANYA bisa meloloskan/veto (bukan bikin sinyal).
            # FAIL-OPEN: AI error/timeout/tanpa-key -> lanjut entry, kecuali AI_VETO_STRICT=true.
            # AI-RADAR-READ-V1
            # Read DeepSeek/Kimi JSON radar as small bonus/penalty. No direct orders.
            try:
                import os as _air_os, json as _air_json, time as _air_time
                from pathlib import Path as _air_Path
                _air_enable = str(_air_os.getenv('AI_RADAR_READ_ENABLE', 'true')).strip().lower() in ('1','true','yes','y','on')
                _air_max_age = float(_air_os.getenv('AI_RADAR_MAX_AGE_SEC', '1800'))
                _air_bonus_max = float(_air_os.getenv('AI_RADAR_BONUS_MAX', '0.60'))
                _air_penalty_max = float(_air_os.getenv('AI_RADAR_PENALTY_MAX', '0.60'))

                def _air_load(_path):
                    try:
                        _pp = _air_Path(_path)
                        if not _pp.exists():
                            return None
                        _obj = _air_json.loads(_pp.read_text())
                        _age = _air_time.time() - _pp.stat().st_mtime
                        if _age > _air_max_age:
                            return None
                        return _obj
                    except Exception:
                        return None

                def _air_apply(_obj, _label):
                    nonlocal conf_score
                    if not _obj or not isinstance(_obj, dict):
                        return
                    _pairs = _obj.get('pairs', {})
                    if not isinstance(_pairs, dict):
                        return
                    _row = _pairs.get(sym) or _pairs.get(str(sym).upper())
                    if not isinstance(_row, dict):
                        return
                    _side = str(_row.get('side') or _row.get('preferred') or _row.get('direction') or '').upper()
                    _score = float(_row.get('score') or 0.0)
                    if _side not in ('LONG','SHORT','WAIT'):
                        return
                    if _score <= 0:
                        return
                    _bonus = min(_air_bonus_max, max(0.0, (_score - 5.0) / 5.0 * _air_bonus_max))
                    _pen = min(_air_penalty_max, max(0.0, (_score - 5.0) / 5.0 * _air_penalty_max))
                    if _side == sig_side and _bonus > 0:
                        conf_score += _bonus
                        try:
                            sc_parts.append(f'{_label}+{_bonus:.2f}')
                        except Exception:
                            pass
                        event(f"AI-RADAR {_label} bonus {sym} {sig_side}: side={_side} score={_score:.1f} +{_bonus:.2f}")
                    elif _side in ('LONG','SHORT') and _side != sig_side and _pen > 0:
                        conf_score -= _pen
                        try:
                            sc_parts.append(f'{_label}-{_pen:.2f}')
                        except Exception:
                            pass
                        event(f"AI-RADAR {_label} penalty {sym} {sig_side}: radar={_side} score={_score:.1f} -{_pen:.2f}")

                if _air_enable:
                    _air_apply(_air_load(_air_os.getenv('AI_DEEPSEEK_SCOUT_FILE', 'logs/deepseek_scout.json')), 'DEEPSEEK')
                    _air_apply(_air_load(_air_os.getenv('AI_KIMI_ANALYST_FILE', 'logs/kimi_analyst.json')), 'KIMI')
            except Exception as _air_e:
                event(f"AI-RADAR read err {sym}: {_air_e}", "warning")

            # ANTI-CHASE-REVERSE-SCOUT-V1
            # Setelah profit, jangan chase searah di pucuk/dasar.
            # Kalau harga sudah lari terlalu jauh dari entry profit terakhir:
            # - block re-entry searah
            # - arah lawan diberi scout bonus kecil, tetap wajib lolos gate/AI
            try:
                import os as _acr_os, time as _acr_time
                _acr_enable = str(_acr_os.getenv('ANTI_CHASE_REVERSE_SCOUT_ENABLE', 'true')).strip().lower() in ('1','true','yes','y','on')
                _acr_cd = float(_acr_os.getenv('ANTI_CHASE_REVERSE_SCOUT_COOLDOWN_SEC', '3600'))
                _acr_max = float(_acr_os.getenv('ANTI_CHASE_REVERSE_SCOUT_MAX_MOVE_PCT', '0.006'))
                _acr_bonus = float(_acr_os.getenv('ANTI_CHASE_REVERSE_SCOUT_BONUS', '0.35'))
                _acr_now = float(_acr_time.time())
                _acr_last = state.get('last_reentry_chase', {}).get(sym, {})
                _acr_block = False
                _acr_reverse = False
                _acr_reason = ''
                if _acr_enable and isinstance(_acr_last, dict):
                    _acr_last_side = str(_acr_last.get('side', '')).upper()
                    _acr_entry = float(_acr_last.get('entry_price') or 0.0)
                    _acr_close_ts = float(_acr_last.get('close_ts') or 0.0)
                    _acr_profit = float(_acr_last.get('realized') or 0.0)
                    _acr_age = _acr_now - _acr_close_ts if _acr_close_ts > 0 else 999999.0
                    _acr_price = float(locals().get('last_price', 0.0) or locals().get('price', 0.0) or locals().get('mark_price', 0.0) or 0.0)
                    if _acr_price <= 0:
                        try:
                            _acr_price = float(df.iloc[-1]['close'])
                        except Exception:
                            _acr_price = 0.0

                    if _acr_profit > 0 and _acr_entry > 0 and _acr_price > 0 and _acr_age <= _acr_cd:
                        if _acr_last_side == 'LONG':
                            _acr_move = (_acr_price - _acr_entry) / _acr_entry
                            if _acr_move >= _acr_max:
                                if sig_side == 'LONG':
                                    _acr_block = True
                                    _acr_reason = f'LONG chase after profit +{_acr_move*100:.2f}% from last entry age={_acr_age:.0f}s'
                                elif sig_side == 'SHORT':
                                    _acr_reverse = True
                                    _acr_reason = f'SHORT reverse scout after LONG profit chase +{_acr_move*100:.2f}% age={_acr_age:.0f}s'
                        elif _acr_last_side == 'SHORT':
                            _acr_move = (_acr_entry - _acr_price) / _acr_entry
                            if _acr_move >= _acr_max:
                                if sig_side == 'SHORT':
                                    _acr_block = True
                                    _acr_reason = f'SHORT chase after profit +{_acr_move*100:.2f}% from last entry age={_acr_age:.0f}s'
                                elif sig_side == 'LONG':
                                    _acr_reverse = True
                                    _acr_reason = f'LONG reverse scout after SHORT profit chase +{_acr_move*100:.2f}% age={_acr_age:.0f}s'

                if _acr_block:
                    event(f"ANTI-CHASE block {sym} {sig_side}: {_acr_reason}")
                    continue

                if _acr_reverse:
                    try:
                        conf_score += _acr_bonus
                    except Exception:
                        pass
                    try:
                        sc_parts.append(f"REVSCOUT+{_acr_bonus:.2f}")
                    except Exception:
                        pass
                    event(f"REVERSE-SCOUT armed {sym} {sig_side}: {_acr_reason} bonus=+{_acr_bonus:.2f}")
            except Exception as _acr_e:
                event(f"ANTI-CHASE-REVERSE-SCOUT err {sym}: {_acr_e}", "warning")

            # AI-SMART-VETO-V1C
            # AI-SMART-VETO-DIRECTION-AWARE-V1D
            # AI-SMART-VETO-CLEAN-VOTES-V1E
            # Conditional AI veto for BOT KERJA RODI:
            # - score below threshold: AI veto active
            # - score strong enough: skip AI veto ONLY if TF votes do not oppose signal
            try:
                import os as _ai_sv_os
                _ai_sv_enable = str(_ai_sv_os.getenv('AI_SMART_VETO_ENABLE', 'true')).strip().lower() in ('1', 'true', 'yes', 'y', 'on')
                _ai_sv_score_min = float(_ai_sv_os.getenv('AI_SMART_VETO_SCORE_MIN', '4.0'))
                _ai_sv_score = float(conf_score)
            except Exception:
                _ai_sv_enable = True
                _ai_sv_score_min = 4.0
                _ai_sv_score = 0.0
            
            _ai_sv_force_veto = False
            _ai_sv_vote_note = ''
            try:
                _votes = locals().get('_dg_votes', [])
                _long_n = sum(1 for _v in _votes if len(_v) >= 2 and str(_v[1]).upper() == 'LONG')
                _short_n = sum(1 for _v in _votes if len(_v) >= 2 and str(_v[1]).upper() == 'SHORT')
                _ai_sv_vote_note = f' votes long={_long_n} short={_short_n}'
                # v1e clean votes:
                # Auto-skip AI veto hanya kalau vote searah bersih.
                # LONG  wajib long>=3 dan short==0
                # SHORT wajib short>=3 dan long==0
                if sig_side == 'LONG':
                    if not (_long_n >= 3 and _short_n == 0):
                        _ai_sv_force_veto = True
                elif sig_side == 'SHORT':
                    if not (_short_n >= 3 and _long_n == 0):
                        _ai_sv_force_veto = True
            except Exception as _ai_sv_vote_e:
                _ai_sv_vote_note = f' votes unknown:{_ai_sv_vote_e}'
            
            if _ai_sv_enable and _ai_sv_score >= _ai_sv_score_min and not _ai_sv_force_veto:
                event(f"AI-SMART-VETO skip {sym} {sig_side} score {_ai_sv_score:+.1f} >= {_ai_sv_score_min:+.1f}{_ai_sv_vote_note}")
            else:
                if _ai_sv_enable and _ai_sv_score >= _ai_sv_score_min and _ai_sv_force_veto:
