def load_news_bias(settings):
    """v10: Baca arah bias berita dari AI Agent (logs/news_bias.json).

    Return ("long"|"short"|"neutral", info_dict).
    AI Agent menulis file ini tiap interval; bot membacanya untuk
    memfilter arah signal (berita buruk -> hanya SHORT, baik -> hanya LONG).
    """
    import json as _json, time as _time
    try:
        if not getattr(settings, "news_bias_enable", True):
            return "neutral", {}
        if not NEWS_BIAS_FILE.exists():
            return "neutral", {}
        data = _json.loads(NEWS_BIAS_FILE.read_text())
        ttl  = float(getattr(settings, "news_bias_ttl_seconds", 10800))
        ts   = float(data.get("ts", 0))
        if ttl > 0 and (_time.time() - ts) > ttl:
            return "neutral", data  # kadaluarsa
        bias = str(data.get("bias", "neutral")).lower()
        if bias not in ("long", "short", "neutral"):
            bias = "neutral"
        return bias, data
    except Exception:
        return "neutral", {}






