                _fs_s15 = _fs_state("15m")

                _bounce_votes = sum(1 for _x in [_fs_s1, _fs_s3, _fs_s5, _fs_s15] if _x == "bounce_up")
                _reject_votes = sum(1 for _x in [_fs_s1, _fs_s3, _fs_s5, _fs_s15] if _x == "reject_down")

                # Lebih ketat: kalau 5m/15m ikut bounce, SHORT harus diblok meski vote cuma 2.
                _major_bounce = (_fs_s5 == "bounce_up" or _fs_s15 == "bounce_up")
                _major_reject = (_fs_s5 == "reject_down" or _fs_s15 == "reject_down")

                if sig_side == "SHORT" and _bounce_votes >= 2 and _major_bounce:
                    event(
                        f"{sym}: FASTSCAN-MTF block SHORT "
                        f"(1m={_fs_s1}, 3m={_fs_s3}, 5m={_fs_s5}, 15m={_fs_s15})"
                    )
                    refresh_dashboard(free, daily, positions_view)
                    time.sleep(1)
                    continue

                if sig_side == "LONG" and _reject_votes >= 2 and _major_reject:
                    event(
                        f"{sym}: FASTSCAN-MTF block LONG "
                        f"(1m={_fs_s1}, 3m={_fs_s3}, 5m={_fs_s5}, 15m={_fs_s15})"
                    )
                    refresh_dashboard(free, daily, positions_view)
                    time.sleep(1)
                    continue

            except Exception as _fs_mtf_e:
                event(f"FASTSCAN-MTF guard error {sym}: {_fs_mtf_e}", "warning")

            # -------- Entry (hybrid: limit utk SOL/DOGE/XRP, market utk BNB) --------
            entry_fill = price
            if prof.order_type == "limit":
                bt = client.book_ticker(sym)
                limit_p = float(bt.get("bidPrice" if sig_side == "LONG" else "askPrice") or price)
                if settings.maker_first_enable:
                    _bid = float(bt.get("bidPrice") or limit_p)
                    _ask = float(bt.get("askPrice") or limit_p)
                    _tick = client.trade_rules(sym).get("tick_size", 0) or 0
                    limit_p = maker_price(sig_side, _bid, _ask, _tick, settings.maker_first_offset_ticks)
                try:
                    order = client.entry_limit_order(sym, sig_side, qty, limit_p)
                except Exception as e:
                    event(f"Limit entry {sym} failed: {e}", "warning")
                    time.sleep(settings.loop_seconds); continue
                oid = order.get("orderId")
                filled = False
                if settings.dry_run:
                    filled = True
                else:
                    waited = 0
                    while waited < settings.limit_fill_timeout_sec:
                        time.sleep(2); waited += 2
                        try:
                            st = client.order_status(sym, oid)
                            if str(st.get("status")) == "FILLED":
                                filled = True; break
                        except Exception:
                            continue
                    if not filled:
                        try: client.cancel_order(sym, oid)
                        except Exception: pass
                        event(f"Limit {sig_side} {sym} not filled in {settings.limit_fill_timeout_sec}s, cancelled")
                        refresh_dashboard(free, daily, positions_view); time.sleep(settings.loop_seconds); continue
                entry_fill = limit_p
                event(f"ENTRY LIMIT {sig_side} {sym} qty={qty} @ {client.round_price(sym, limit_p)} | ML conf={conf:.2f}")
            else:
                _ice = []
                if (settings.iceberg_enable
                        and qty * price >= (rules.get("min_notional", 5.0) or 5.0) * settings.iceberg_min_notional_mult):
                    _ice = split_iceberg(qty, settings.iceberg_chunks,
                                         rules.get("step_size", 0) or 0, rules.get("min_qty", 0) or 0)
                if len(_ice) > 1:
                    for _ci, _cq in enumerate(_ice):
                        client.entry_order(sym, sig_side, _cq)
                        if _ci < len(_ice) - 1:
                            time.sleep(0.5)
                    event(f"ENTRY MARKET iceberg x{len(_ice)} {sig_side} {sym} qty={qty} @~{price} | ML conf={conf:.2f}")
                else:
                    client.entry_order(sym, sig_side, qty)
                    event(f"ENTRY MARKET {sig_side} {sym} qty={qty} @~{price} | ML conf={conf:.2f}")

            # Ambil entry price aktual dari posisi (jika live)
            try:
                pos = next((q for q in client.open_positions() if q.get("symbol") == sym), None)
                if pos and float(pos.get("entryPrice") or 0) > 0:
                    entry_fill = float(pos["entryPrice"])
            except Exception:
                pass

            # -------- SL/TP per-pair (RR 1:2 + ATR utk SOL) --------
            try:
                kl2   = client.klines(sym, tf0, 80)
                highs_e = [float(k[2]) for k in kl2]
                lows_e  = [float(k[3]) for k in kl2]
                closes_e= [float(k[4]) for k in kl2]
                atr_e   = atr(highs_e, lows_e, closes_e, 14)
            except Exception:
                atr_e = 0.0

            sl, tp, sl_dist = plan_levels(sym, sig_side, entry_fill, atr_e, eff_min_tp, hc_meta.get("tp_mult", 0.0))
            if settings.dynamic_atr_tpsl_enable and atr_e > 0:
                _tb = dynamic_atr_tpsl(sig_side, entry_fill, atr_e,
                                       sl_mult=settings.atr_sl_mult, tp_mult=settings.atr_tp_mult,
                                       min_sl_pct=settings.atr_tpsl_min_sl_pct,
                                       max_sl_pct=settings.atr_tpsl_max_sl_pct)
                sl, tp, sl_dist = _tb.sl, _tb.tp, _tb.sl_dist
                event(f"Dynamic ATR TP/SL {sym}: SL={client.round_price(sym,sl)} TP={client.round_price(sym,tp)} (ATR={atr_e:.6f})")
            try:
                client.stop_loss_order(sym, sig_side, sl, qty)
                client.take_profit_order(sym, sig_side, tp, qty)
                sl_pct_r = sl_dist / entry_fill * 100 if entry_fill > 0 else 0
                event(f"SL={client.round_price(sym,sl)} TP={client.round_price(sym,tp)} (SL {sl_pct_r:.2f}% RR 1:{prof.rr:.0f})")
            except Exception as e:
                event(f"Placing SL/TP {sym} failed (code {_binance_code(e)}): {e}", "error")

            # Telegram: notif entry
            tg.entry(sym, sig_side, qty, entry_fill, sl, tp, conf,
                     fng=_sentiment.get("score", 50))

            state["last_trade_ts"] = time.time()
            state["daily_trades"]   = state.get("daily_trades", 0) + 1
            state.setdefault("last_trade_per_pair", {})[sym] = time.time()
            state.setdefault("entry_time", {})[sym] = time.time()
            save_state(state)
            refresh_dashboard(free, daily, positions_view)
            time.sleep(settings.loop_seconds)

        except KeyboardInterrupt:
            event("Dihentikan oleh user")
            break
        except Exception as e:
            event(f"Loop error: {e}", "error")
            time.sleep(10)


if __name__ == "__main__":
    main()
