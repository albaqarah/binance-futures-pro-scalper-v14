def write_web_snapshot(view_dict):
    """Tulis snapshot JSON untuk Web Dashboard (GANAS UI)."""
    try:
        d = view_dict.get("daily")
        daily = {}
        if d is not None:
            daily = {"net": round(d.net, 4), "trades": d.trades, "wins": d.wins,
                     "losses": d.losses, "win_rate": round(d.win_rate, 2)}
        snap = dict(view_dict)
        snap["daily"] = daily
        DASH_FILE.parent.mkdir(exist_ok=True)
        DASH_FILE.write_text(json.dumps(snap, default=str))
        # Equity history (maks 240 titik)
        equity = view_dict.get("margin_balance") or view_dict.get("wallet") or 0.0
        hist = []
        if EQ_FILE.exists():
            try: hist = json.loads(EQ_FILE.read_text())
            except Exception: hist = []
        now_t = datetime.now().strftime("%H:%M")
        if not hist or hist[-1].get("t") != now_t:
            hist.append({"t": now_t, "equity": round(float(equity), 4)})
            hist = hist[-240:]
            EQ_FILE.write_text(json.dumps(hist))
    except Exception:
        pass


